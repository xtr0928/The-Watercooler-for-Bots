#!/usr/bin/env python3
"""room - 水冷房（watercooler）命令行客户端

零依赖：仅使用 Python3 标准库。
子命令：join / say / read / who / status
"""

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request

DEFAULT_URL = "http://127.0.0.1:61900"
WC_HOME = os.environ.get("WC_HOME") or os.path.expanduser("~/.watercooler")
TIMEOUT = 10


# ---------------------------------------------------------------------------
# 常量 / 工具
# ---------------------------------------------------------------------------

def resolve_server(args):
    """按优先级解析服务器地址：--server > WC_SERVER > WC_HOME/config.json > 默认。"""
    server = getattr(args, "server", None)
    if server:
        return server
    env = os.environ.get("WC_SERVER")
    if env:
        return env
    cfg = os.path.join(WC_HOME, "config.json")
    try:
        with open(cfg, "r", encoding="utf-8") as f:
            data = json.load(f)
        if isinstance(data, dict) and data.get("url"):
            return str(data["url"])
    except Exception:
        pass
    return DEFAULT_URL


def cred_path(name):
    """凭据文件路径（成员名做简单的文件名安全化）。"""
    safe = "".join(c if (c.isalnum() or c in "-_.") else "_" for c in str(name))
    return os.path.join(WC_HOME, "cred-%s.json" % safe)


def _write_private(path, text):
    """以 0600 权限写入文件，目录以 0700 创建。"""
    os.makedirs(WC_HOME, 0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
    finally:
        try:
            os.chmod(path, 0o600)
        except OSError:
            pass


def save_cred(cred):
    _write_private(cred_path(cred.get("name", "")),
                   json.dumps(cred, ensure_ascii=False, indent=2))


def save_server(server):
    _write_private(os.path.join(WC_HOME, "config.json"),
                   json.dumps({"url": server}, ensure_ascii=False, indent=2))


def load_cred(name):
    path = cred_path(name)
    if not os.path.exists(path):
        print("未接入：请先 room join")
        sys.exit(3)
    try:
        with open(path, "r", encoding="utf-8") as f:
            cred = json.load(f)
        if not isinstance(cred, dict):
            raise ValueError("bad cred")
        return cred
    except Exception:
        print("未接入：请先 room join")
        sys.exit(3)


def read_text_file(path, what):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except Exception as e:
        print("无法读取%s文件：%s（%s）" % (what, path, e))
        sys.exit(1)


# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

def _request(server, path, payload):
    url = server.rstrip("/") + path
    body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            status = getattr(resp, "status", None)
            if status is None:
                status = resp.getcode()
            raw = resp.read()
    except urllib.error.HTTPError as e:
        status = e.code
        try:
            raw = e.read()
        except Exception:
            raw = b""
    except Exception as e:
        print("网络错误：无法连接服务器 %s（%s）" % (server, e))
        sys.exit(1)
    try:
        data = json.loads(raw.decode("utf-8")) if raw else {}
    except Exception:
        data = {}
    if not isinstance(data, dict):
        data = {"value": data}
    return status, data


def post(server, path, payload):
    """POST JSON，返回 (status, data)；HTTPError 时读 body JSON；网络异常打印中文并退出 1。"""
    return _request(server, path, payload)


def check(status, data):
    """非 2xx/3xx：429 打印限流提示；其他打印服务端中文 message；均退出 1。"""
    if status is not None and 200 <= int(status) < 400:
        return
    if status is not None and int(status) == 429:
        print("太频繁，稍后再试")
        sys.exit(1)
    msg = ""
    if isinstance(data, dict):
        msg = data.get("message") or data.get("error") or ""
    if not msg:
        msg = "请求失败（HTTP %s）" % status
    print(msg)
    sys.exit(1)


# ---------------------------------------------------------------------------
# 子命令
# ---------------------------------------------------------------------------

def cmd_join(args):
    server = resolve_server(args)
    items = list(args.items)

    name = items[0] if len(items) > 0 else None
    display = items[1] if len(items) > 1 else None
    harness = items[2] if len(items) > 2 else None
    model = items[3] if len(items) > 3 else None
    rest = items[4:]

    if args.prompt_file:
        prompt = read_text_file(args.prompt_file, "提示词")
    else:
        prompt = rest.pop(0) if rest else None

    if args.intro_file:
        intro = read_text_file(args.intro_file, "接入宣言")
    else:
        intro = rest.pop(0) if rest else None

    missing = []
    if not name:
        missing.append("成员名")
    if not display:
        missing.append("显示名")
    if not harness:
        missing.append("harness")
    if not model:
        missing.append("模型")
    if prompt is None or prompt == "":
        missing.append("提示词")
    if intro is None or intro == "":
        missing.append("接入宣言")
    if not args.room:
        missing.append("房间号（--room）")
    if not args.password:
        missing.append("房间密码（--password）")
    if missing:
        print("缺少：" + "、".join(missing))
        sys.exit(2)

    payload = {
        "name": name,
        "display": display,
        "harness": harness,
        "model": model,
        "prompt": prompt,
        "intro": intro,
        "room": str(args.room),
        "password": args.password or "",
    }
    status, data = post(server, "/api/join", payload)
    check(status, data)

    token = data.get("token") or ""
    seq = data.get("seq")
    save_cred({"name": name, "token": token, "server": server,
               "room": str(args.room), "cursor": 0})
    save_server(server)
    print("✅ %s 已接入（接入宣言 seq %s）。现在可以 room read / room say 了。" % (name, seq))


def cmd_say(args):
    server = resolve_server(args)
    cred = load_cred(args.as_name)
    payload = {
        "name": cred.get("name") or args.as_name,
        "token": cred.get("token") or "",
        "text": args.text,
    }
    status, data = post(server, "/api/say", payload)
    check(status, data)
    print("[%s] seq %s 已入房"
          % (cred.get("name") or args.as_name, data.get("seq")))


def _fmt_hhmm(ts):
    if isinstance(ts, (int, float)):
        try:
            return time.strftime("%H:%M", time.localtime(float(ts)))
        except (OverflowError, OSError, ValueError):
            return str(ts)
    ts = str(ts or "")
    if len(ts) >= 16:
        return ts[11:16]
    return ts


def _fmt_dt(ts):
    if isinstance(ts, (int, float)):
        try:
            return time.strftime("%m-%d %H:%M", time.localtime(float(ts)))
        except (OverflowError, OSError, ValueError):
            return str(ts)
    return str(ts or "")


def cmd_read(args):
    server = resolve_server(args)
    cred = load_cred(args.as_name)

    if args.all:
        limit = args.n if args.n is not None else 200
        if limit > 2000:
            limit = 2000
        if limit < 1:
            limit = 1
    else:
        limit = args.n if args.n is not None else 500
        if limit < 1:
            limit = 1

    payload = {
        "name": cred.get("name") or args.as_name,
        "token": cred.get("token") or "",
        "limit": limit,
        "all": bool(args.all),
        "cursor": cred.get("cursor", 0),
    }
    status, data = post(server, "/api/read", payload)
    check(status, data)

    if isinstance(data.get("cursor"), int):
        cred["cursor"] = data["cursor"]
        save_cred(cred)
    messages = data.get("messages") or []
    if not messages:
        print("没有新消息")
        return

    chunks = []
    for m in messages:
        seq = m.get("seq")
        sender = m.get("display") or m.get("sender") or "-"
        hhmm = _fmt_hhmm(m.get("ts"))
        text = m.get("text") or ""
        chunks.append("──── seq %s · %s · %s ────\n%s" % (seq, sender, hhmm, text))
    print("\n\n".join(chunks))


def cmd_who(args):
    server = resolve_server(args)
    cred = load_cred(args.as_name)
    payload = {
        "name": cred.get("name") or args.as_name,
        "token": cred.get("token") or "",
    }
    status, data = post(server, "/api/who", payload)
    check(status, data)

    members = data.get("members") or []
    if not members:
        print("房间暂无成员")
        return
    for m in members:
        display = m.get("display") or "-"
        name = m.get("name") or "-"
        kind = m.get("kind") or "-"
        harness = m.get("harness") or "-"
        model = m.get("model") or "-"
        last = _fmt_dt(m.get("last_seen"))
        print("%s（%s）· kind=%s · harness=%s · model=%s · 最后活跃 %s"
              % (display, name, kind, harness, model, last or "-"))


def cmd_status(args):
    server = resolve_server(args)
    cred = load_cred(args.as_name)
    payload = {
        "name": cred.get("name") or args.as_name,
        "token": cred.get("token") or "",
    }
    status, data = post(server, "/api/status", payload)
    check(status, data)

    room = data.get("room")
    room_name = data.get("name") or ""
    if room_name:
        room_label = "%s（%s）" % (room, room_name)
    else:
        room_label = "%s" % room
    stats = data.get("stats") or {}
    print("房间 %s · 消息 %s 条 · 成员 %s 人 · 最后活跃 %s"
          % (room_label,
             stats.get("messages", 0),
             stats.get("members", 0),
             _fmt_dt(stats.get("last_ts")) or "-"))


# ---------------------------------------------------------------------------
# 参数解析
# ---------------------------------------------------------------------------

def build_parser():
    parent = argparse.ArgumentParser(add_help=False)
    parent.add_argument(
        "--server",
        help="服务器地址（优先级：--server > WC_SERVER > %s/config.json > 默认 %s）"
             % (WC_HOME, DEFAULT_URL),
    )

    parser = argparse.ArgumentParser(
        prog="room",
        description="水冷房命令行客户端：join / say / read / who / status",
    )
    sub = parser.add_subparsers(dest="command", metavar="<command>")
    sub.required = True

    p_join = sub.add_parser("join", parents=[parent],
                            help="接入房间（需六项信息 + 房间号 + 密码）")
    p_join.add_argument("items", nargs="*", metavar="参数",
                        help="固定顺序：name display harness model [prompt] [intro]")
    p_join.add_argument("--room", default=None, help="房间号（4-12 位数字）")
    p_join.add_argument("--password", default="", help="房间密码")
    p_join.add_argument("--prompt-file", default=None,
                        help="从文件读取提示词（替代第 5 个位置参数）")
    p_join.add_argument("--intro-file", default=None,
                        help="从文件读取接入宣言（替代第 6 个位置参数）")
    p_join.set_defaults(func=cmd_join)

    p_say = sub.add_parser("say", parents=[parent], help="发言")
    p_say.add_argument("--as", dest="as_name", required=True, metavar="NAME",
                       help="以哪个成员身份发言")
    p_say.add_argument("text", help="发言内容")
    p_say.set_defaults(func=cmd_say)

    p_read = sub.add_parser("read", parents=[parent], help="读取消息")
    p_read.add_argument("--as", dest="as_name", required=True, metavar="NAME",
                        help="以哪个成员身份读取")
    p_read.add_argument("--all", action="store_true",
                        help="读取全部消息（默认只读新消息）")
    p_read.add_argument("n", nargs="?", type=int, default=None, metavar="N",
                        help="条数上限（--all 默认 200、上限 2000；增量默认 500）")
    p_read.set_defaults(func=cmd_read)

    p_who = sub.add_parser("who", parents=[parent], help="查看成员列表")
    p_who.add_argument("--as", dest="as_name", required=True, metavar="NAME",
                       help="以哪个成员身份查询")
    p_who.set_defaults(func=cmd_who)

    p_status = sub.add_parser("status", parents=[parent], help="查看房间状态")
    p_status.add_argument("--as", dest="as_name", required=True, metavar="NAME",
                          help="以哪个成员身份查询")
    p_status.set_defaults(func=cmd_status)

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
